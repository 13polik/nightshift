[sub_resource type="Resource" id="loot"]
script = ExtResource("loot_s")
weights = {
"access_decoder": 0.4,
"arc_cell": 1.0,
"arc_emitter": 0.4,
"bandage": 3.0,
"battery": 3.0,
"crowbar": 0.6,
"medkit": 1.0
}
guaranteed = {
"arc_emitter": 1,
"battery": 2,
"crowbar": 1
}
fill_ratio = 0.4
container_fill_ratio = 0.55

