[sub_resource type="Resource" id="rewards"]
script = ExtResource("rew_s")

[resource]
script = ExtResource("mis_s")
id = &"quarantine"
name_key = "MISSION_QUARANTINE"
description_key = "MISSION_QUARANTINE_DESC"
location_key = "LOC_QUARANTINE"
layout_path = "res://data/facilities/quarantine.json"
objectives = Array[ExtResource("obj_s")]([SubResource("o_reach_decon"), SubResource("o_generator"), SubResource("o_power"), SubResource("o_culture_logs"), SubResource("o_field_parts"), SubResource("o_repair_field"), SubResource("o_extract_culture"), SubResource("o_secure_culture"), SubResource("o_call_evac"), SubResource("o_survive"), SubResource("o_extract")])
optional_objectives = Array[ExtResource("obj_s")]([SubResource("o_opt_drives")])
events = Array[ExtResource("event_s")]([ExtResource("ev_power_failure"), ExtResource("ev_lockdown"), ExtResource("ev_alarm"), ExtResource("ev_hunter_alert"), ExtResource("ev_emergency_evacuation"), ExtResource("ev_generator_noise")])
loot_table = SubResource("loot")
rewards = SubResource("rewards")
enemies = Array[ExtResource("enemy_s")]([ExtResource("hunter"), ExtResource("hunter")])
enemy_release_time = 95.0
recommended_level = 4
unlock_level = 4
threat_per_minute = 0.045
target_duration_minutes = 16.0
