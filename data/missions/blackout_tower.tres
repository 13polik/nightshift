[sub_resource type="Resource" id="rewards"]
script = ExtResource("rew_s")

[resource]
script = ExtResource("mis_s")
id = &"blackout_tower"
name_key = "MISSION_BLACKOUT_TOWER"
description_key = "MISSION_BLACKOUT_TOWER_DESC"
location_key = "LOC_BLACKOUT_TOWER"
layout_path = "res://data/facilities/blackout_tower.json"
objectives = Array[ExtResource("obj_s")]([SubResource("o_reach_atrium"), SubResource("o_power"), SubResource("o_access_logs"), SubResource("o_exec_key"), SubResource("o_copy_server"), SubResource("o_backups"), SubResource("o_call_evac"), SubResource("o_survive"), SubResource("o_extract")])
optional_objectives = Array[ExtResource("obj_s")]([SubResource("o_opt_server")])
events = Array[ExtResource("event_s")]([ExtResource("ev_power_failure"), ExtResource("ev_lockdown"), ExtResource("ev_alarm"), ExtResource("ev_hunter_alert"), ExtResource("ev_emergency_evacuation"), ExtResource("ev_generator_noise")])
loot_table = SubResource("loot")
rewards = SubResource("rewards")
enemies = Array[ExtResource("enemy_s")]([ExtResource("hunter")])
enemy_release_time = 80.0
recommended_level = 5
unlock_level = 5
threat_per_minute = 0.050
target_duration_minutes = 15.0
