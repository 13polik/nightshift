[sub_resource type="Resource" id="rewards"]
script = ExtResource("rew_s")

[resource]
script = ExtResource("mis_s")
id = &"iron_gate"
name_key = "MISSION_IRON_GATE"
description_key = "MISSION_IRON_GATE_DESC"
location_key = "LOC_IRON_GATE"
layout_path = "res://data/facilities/iron_gate.json"
objectives = Array[ExtResource("obj_s")]([SubResource("o_reach_guard"), SubResource("o_generator"), SubResource("o_power"), SubResource("o_transfer_record"), SubResource("o_master_key"), SubResource("o_open_block_c"), SubResource("o_reach_solitary"), SubResource("o_call_evac"), SubResource("o_survive"), SubResource("o_extract")])
optional_objectives = Array[ExtResource("obj_s")]([SubResource("o_opt_drives")])
events = Array[ExtResource("event_s")]([ExtResource("ev_power_failure"), ExtResource("ev_lockdown"), ExtResource("ev_alarm"), ExtResource("ev_hunter_alert"), ExtResource("ev_emergency_evacuation"), ExtResource("ev_generator_noise")])
loot_table = SubResource("loot")
rewards = SubResource("rewards")
enemies = Array[ExtResource("enemy_s")]([ExtResource("hunter"), ExtResource("hunter")])
enemy_release_time = 90.0
recommended_level = 5
unlock_level = 5
threat_per_minute = 0.050
target_duration_minutes = 17.0
