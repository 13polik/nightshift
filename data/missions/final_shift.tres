[resource]
script = ExtResource("mis_s")
id = &"final_shift"
name_key = "MISSION_FINAL_SHIFT"
description_key = "MISSION_FINAL_SHIFT_DESC"
location_key = "LOC_FINAL_SHIFT"
layout_path = "res://data/facilities/final_shift.json"
objectives = Array[ExtResource("obj_s")]([SubResource("o_reach_checkpoint"), SubResource("o_generator"), SubResource("o_power"), SubResource("o_deep_security"), SubResource("o_origin"), SubResource("o_grid_parts"), SubResource("o_rebuild_grid"), SubResource("o_director_key"), SubResource("o_seal_nest"), SubResource("o_last_sample"), SubResource("o_call_evac"), SubResource("o_survive"), SubResource("o_extract")])
optional_objectives = Array[ExtResource("obj_s")]([SubResource("o_opt_drives")])
events = Array[ExtResource("event_s")]([ExtResource("ev_power_failure"), ExtResource("ev_lockdown"), ExtResource("ev_alarm"), ExtResource("ev_hunter_alert"), ExtResource("ev_emergency_evacuation"), ExtResource("ev_generator_noise")])
loot_table = SubResource("loot")
rewards = SubResource("rewards")
enemies = Array[ExtResource("enemy_s")]([ExtResource("hunter"), ExtResource("hunter"), ExtResource("hunter")])
enemy_release_time = 80.0
recommended_level = 8
unlock_level = 8
threat_per_minute = 0.060
target_duration_minutes = 20.0
