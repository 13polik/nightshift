[sub_resource type="Resource" id="o_survive"]
script = ExtResource("obj_s")
id = &"survive"
title_key = "OBJ_DEEP_ARCHIVE_SURVIVE"
hint_key = "OBJ_DEEP_ARCHIVE_SURVIVE_HINT"
