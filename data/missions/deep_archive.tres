[sub_resource type="Resource" id="o_opt_server"]
script = ExtResource("obj_s")
id = &"opt_server"
title_key = "OBJ_DEEP_ARCHIVE_OPT_SERVER"
hint_key = "OBJ_DEEP_ARCHIVE_OPT_SERVER_HINT"
type = 1
target_tag = &"server_terminal"
duration = 8.00
