reward_xp = 100
reward_currency = 25
optional = true

[sub_resource type="Resource" id="rewards"]
script = ExtResource("rew_s")

[resource]
script = ExtResource("mis_s")
id = &"deep_archive"
name_key = "MISSION_DEEP_ARCHIVE"
description_key = "MISSION_DEEP_ARCHIVE_DESC"
location_key = "LOC_DEEP_ARCHIVE"
layout_path = "res://data/facilities/deep_archive.json"
objectives = Array[ExtResource("obj_s")]([SubResource("o_reach_security"), SubResource("o_lockdown"), SubResource("o_vault_key"), SubResource("o_decrypt"), SubResource("o_kessler_files"), SubResource("o_call_evac"), SubResource("o_survive"), SubResource("o_extract")])
optional_objectives = Array[ExtResource("obj_s")]([SubResource("o_opt_server")])
events = Array[ExtResource("event_s")]([ExtResource("ev_power_failure"), ExtResource("ev_lockdown"), ExtResource("ev_alarm"), ExtResource("ev_hunter_alert"), ExtResource("ev_emergency_evacuation"), ExtResource("ev_generator_noise")])
loot_table = SubResource("loot")
rewards = SubResource("rewards")
enemies = Array[ExtResource("enemy_s")]([ExtResource("hunter")])
enemy_release_time = 80.0
recommended_level = 3
unlock_level = 3
threat_per_minute = 0.040
target_duration_minutes = 14.0
start_powered = true
