[resource]
script = ExtResource("mis_s")
id = &"shelter_twelve"
name_key = "MISSION_SHELTER_TWELVE"
description_key = "MISSION_SHELTER_TWELVE_DESC"
location_key = "LOC_SHELTER_TWELVE"
layout_path = "res://data/facilities/shelter_twelve.json"
objectives = Array[ExtResource("obj_s")]([SubResource("o_reach_airlock"), SubResource("o_generator"), SubResource("o_power"), SubResource("o_filter_parts"), SubResource("o_restart_filters"), SubResource("o_roster"), SubResource("o_door_key"), SubResource("o_logbooks"), SubResource("o_call_evac"), SubResource("o_survive"), SubResource("o_extract")])
optional_objectives = Array[ExtResource("obj_s")]([SubResource("o_opt_server")])
events = Array[ExtResource("event_s")]([ExtResource("ev_power_failure"), ExtResource("ev_lockdown"), ExtResource("ev_alarm"), ExtResource("ev_hunter_alert"), ExtResource("ev_emergency_evacuation"), ExtResource("ev_generator_noise")])
loot_table = SubResource("loot")
rewards = SubResource("rewards")
enemies = Array[ExtResource("enemy_s")]([ExtResource("hunter"), ExtResource("hunter")])
enemy_release_time = 90.0
recommended_level = 7
unlock_level = 7
threat_per_minute = 0.050
target_duration_minutes = 16.0
