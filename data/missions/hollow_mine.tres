[sub_resource type="Resource" id="rewards"]
script = ExtResource("rew_s")

[resource]
script = ExtResource("mis_s")
id = &"hollow_mine"
name_key = "MISSION_HOLLOW_MINE"
description_key = "MISSION_HOLLOW_MINE_DESC"
location_key = "LOC_HOLLOW_MINE"
layout_path = "res://data/facilities/hollow_mine.json"
objectives = Array[ExtResource("obj_s")]([SubResource("o_reach_lamp_room"), SubResource("o_generator"), SubResource("o_power"), SubResource("o_find_miners"), SubResource("o_foreman_log"), SubResource("o_winch_parts"), SubResource("o_fix_winch"), SubResource("o_call_evac"), SubResource("o_survive"), SubResource("o_extract")])
optional_objectives = Array[ExtResource("obj_s")]([SubResource("o_opt_drives")])
events = Array[ExtResource("event_s")]([ExtResource("ev_power_failure"), ExtResource("ev_lockdown"), ExtResource("ev_alarm"), ExtResource("ev_hunter_alert"), ExtResource("ev_emergency_evacuation"), ExtResource("ev_generator_noise")])
loot_table = SubResource("loot")
rewards = SubResource("rewards")
enemies = Array[ExtResource("enemy_s")]([ExtResource("hunter"), ExtResource("hunter")])
enemy_release_time = 100.0
recommended_level = 6
unlock_level = 6
threat_per_minute = 0.050
target_duration_minutes = 16.0
