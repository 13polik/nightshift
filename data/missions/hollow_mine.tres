[gd_resource type="Resource" script_class="MissionData" format=3]

[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="enemy_s"]
[ext_resource type="Resource" path="res://data/enemies/hunter.tres" id="hunter"]
