[resource]
script = ExtResource("13_mis")
id = &"signal_lost"
name_key = "MISSION_SIGNAL_LOST"
description_key = "MISSION_SIGNAL_LOST_DESC"
location_key = "LOC_HARBOR_DEPOT"
layout_path = "res://data/facilities/harbor_depot.json"
objectives = Array[ExtResource("11_obj")]([SubResource("o_enter"), SubResource("o_gen"), SubResource("o_power"), SubResource("o_team"), SubResource("o_parts"), SubResource("o_mast"), SubResource("o_signal"), SubResource("o_survive"), SubResource("o_extract")])
optional_objectives = Array[ExtResource("11_obj")]([SubResource("opt_research"), SubResource("opt_server")])
events = Array[ExtResource("3_evt")]([ExtResource("4_pf"), ExtResource("5_ld"), ExtResource("6_al"), ExtResource("7_ha"), ExtResource("8_ev"), ExtResource("9_gn")])
loot_table = SubResource("loot")
rewards = SubResource("rewards")
enemies = Array[ExtResource("1_enm")]([ExtResource("2_hunter")])
enemy_release_time = 80.0
recommended_level = 2
threat_per_minute = 0.05
target_duration_minutes = 14.0
