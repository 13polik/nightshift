[sub_resource type="Resource" id="loot"]
script = ExtResource("10_loot")
weights = {
"access_decoder": 0.4,
"arc_cell": 1.2,
"arc_emitter": 0.5,
"bandage": 3.0,
"battery": 3.5,
"crowbar": 0.6,
"medkit": 1.0
}
