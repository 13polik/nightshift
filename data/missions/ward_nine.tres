[sub_resource type="Resource" id="rewards"]
script = ExtResource("rew_s")

[resource]
script = ExtResource("mis_s")
id = &"ward_nine"
name_key = "MISSION_WARD_NINE"
description_key = "MISSION_WARD_NINE_DESC"
location_key = "LOC_WARD_NINE"
layout_path = "res://data/facilities/ward_nine.json"
objectives = Array[ExtResource("obj_s")]([SubResource("o_reach_nurses"), SubResource("o_patient_file"), SubResource("o_power"), SubResource("o_isolation_key"), SubResource("o_isolation"), SubResource("o_secure_sample"), SubResource("o_call_evac"), SubResource("o_survive"), SubResource("o_extract")])
optional_objectives = Array[ExtResource("obj_s")]([SubResource("o_opt_drives")])
events = Array[ExtResource("event_s")]([ExtResource("ev_power_failure"), ExtResource("ev_lockdown"), ExtResource("ev_alarm"), ExtResource("ev_hunter_alert"), ExtResource("ev_emergency_evacuation"), ExtResource("ev_generator_noise")])
loot_table = SubResource("loot")
rewards = SubResource("rewards")
enemies = Array[ExtResource("enemy_s")]([ExtResource("hunter")])
enemy_release_time = 80.0
recommended_level = 2
unlock_level = 2
threat_per_minute = 0.040
target_duration_minutes = 14.0
start_powered = true
