[sub_resource type="Resource" id="o_controller_parts"]
script = ExtResource("obj_s")
id = &"controller_parts"
title_key = "OBJ_OVERLOAD_CONTROLLER_PARTS"
hint_key = "OBJ_OVERLOAD_CONTROLLER_PARTS_HINT"
type = 2
item_pool = PackedStringArray("fuse", "circuit_board", "capacitor")
