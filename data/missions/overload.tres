reward_currency = 25
optional = true

[sub_resource type="Resource" id="rewards"]
script = ExtResource("rew_s")

[resource]
script = ExtResource("mis_s")
id = &"overload"
name_key = "MISSION_OVERLOAD"
description_key = "MISSION_OVERLOAD_DESC"
location_key = "LOC_OVERLOAD"
layout_path = "res://data/facilities/overload.json"
objectives = Array[ExtResource("obj_s")]([SubResource("o_reach_control"), SubResource("o_generator"), SubResource("o_power"), SubResource("o_coolant"), SubResource("o_controller_parts"), SubResource("o_rebuild_controller"), SubResource("o_stabilise"), SubResource("o_call_evac"), SubResource("o_survive"), SubResource("o_extract")])
optional_objectives = Array[ExtResource("obj_s")]([SubResource("o_opt_server")])
events = Array[ExtResource("event_s")]([ExtResource("ev_power_failure"), ExtResource("ev_lockdown"), ExtResource("ev_alarm"), ExtResource("ev_hunter_alert"), ExtResource("ev_emergency_evacuation"), ExtResource("ev_generator_noise")])
loot_table = SubResource("loot")
rewards = SubResource("rewards")
enemies = Array[ExtResource("enemy_s")]([ExtResource("hunter")])
enemy_release_time = 80.0
recommended_level = 3
unlock_level = 3
threat_per_minute = 0.045
target_duration_minutes = 16.0
